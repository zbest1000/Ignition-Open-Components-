# Local, per-user settings: signing credentials and deploy target.
#
# Copy the lines you need into ~/.gradle/gradle.properties (NOT the gradle.properties in this
# repository, which is committed and must stay free of secrets).

# Sign the module (default: false -> build/Open-ECharts.unsigned.modl only).
# signModule=true
# ignition.signing.keystoreFile=/absolute/path/to/keystore.jks
# ignition.signing.keystorePassword=changeit
# ignition.signing.certFile=/absolute/path/to/cert-chain.p7b
# ignition.signing.certAlias=alias
# ignition.signing.certPassword=changeit

# Gateway deploy target for ./gradlew deployModl (development gateways only).
# hostGateway=http://localhost:8088
