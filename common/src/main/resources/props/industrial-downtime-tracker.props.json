{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "events": {
      "type": "array",
      "description": "Downtime events: { equipment, start (epoch ms), end (epoch ms), category, reason? }. Bind to your downtime log.",
      "items": {
        "type": "object",
        "properties": {
          "equipment": { "type": "string" },
          "start":     { "type": "number" },
          "end":       { "type": "number" },
          "category":  { "type": "string" },
          "reason":    { "type": "string" }
        }
      },
      "default": [
        { "equipment": "Line 1", "start": 1699992800000, "end": 1699994600000, "category": "Mechanical", "reason": "Belt failure" },
        { "equipment": "Line 1", "start": 1699996400000, "end": 1699997300000, "category": "Changeover", "reason": "Product A to B" },
        { "equipment": "Line 2", "start": 1699994000000, "end": 1699995800000, "category": "Electrical", "reason": "Drive fault" },
        { "equipment": "Line 3", "start": 1699994600000, "end": 1699994900000, "category": "Operator", "reason": "Wrong setup" }
      ]
    },
    "categoryColors": {
      "type": "object",
      "description": "Map of downtime category to colour. Merged over the built-in defaults.",
      "additionalProperties": { "type": "string" },
      "default": {}
    },
    "showSummary": {
      "type": "boolean",
      "description": "Show the downtime summary.",
      "default": true
    },
    "title": {
      "type": "string",
      "description": "Chart title. Leave blank for the default title.",
      "default": ""
    },
    "option": {
      "type": "object",
      "description": "Advanced override. If non-empty, this ECharts option is used verbatim and the domain props above are ignored.",
      "default": {}
    },
    "theme": { "type": "string", "default": "" },
    "renderer": { "type": "string", "enum": ["canvas", "svg"], "default": "canvas" },
    "autoResize": { "type": "boolean", "default": true },
    "resizeDebounceMs": { "type": "integer", "default": 150 },
    "notMerge": { "type": "boolean", "default": false },
    "lazyUpdate": { "type": "boolean", "default": true },
    "showLoading": { "type": "boolean", "default": false },
    "loadingOptions": { "type": "object", "default": {} },
    "sanitizeTooltip": { "type": "boolean", "default": true },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": { "classes": "" }
    }
  }
}
