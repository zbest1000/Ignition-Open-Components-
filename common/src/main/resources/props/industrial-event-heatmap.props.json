    "timestamps": {
      "type": "array",
      "description": "Raw event times, bucketed by the component: epoch milliseconds, or ISO 8601 strings. Epoch values and strings with a zone (Z, +02:00) are instants and are shifted by utcOffsetMinutes; strings without a zone are taken as local wall-clock time exactly as written. Rows { timestamp | t_stamp | t, weight } are accepted too. When non-empty, replaces cells.",
      "default": []
    },
    "weights": {
      "type": "array",
      "description": "Optional weight of each timestamp, in the same order (e.g. downtime minutes, reject quantity). Leave empty to count every event as 1. When set, events without a valid non-negative weight are skipped.",
      "default": []
    },
    "utcOffsetMinutes": {
      "type": "number",
      "description": "Offset from UTC, in minutes, of the clock the hours and weekdays are read on (e.g. 60 for UTC+1, -300 for UTC-5). Applied to epoch and zoned timestamps. The zone of the browser or gateway is deliberately not used, so every client shows the same chart. A fixed offset does not follow daylight saving time: for data spanning a DST change, aggregate in the database and bind cells.",
      "default": 0
    },
    "weekStart": {
      "type": "string",
      "enum": [
        "monday",
        "sunday"
      ],
      "description": "First day of the week (top row).",
      "default": "monday"
    },
    "dayLabels": {
      "type": "array",
      "description": "Seven day labels, always Monday first (weekStart only changes the row order).",
      "default": [
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat",
        "Sun"
      ]
    },
    "hourStep": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        6
      ],
      "description": "Width of a column in hours: 1, 2, 3, 4 or 6.",
      "default": 1
    },
    "colors": {
      "type": "array",
      "description": "Colour ramp from low to high counts (two or more colours). The default is one hue with rising opacity, so it reads low-to-high on light and dark themes alike. Cells with no events are always drawn in neutral grey, outside this ramp.",
      "default": [
        "rgba(47,125,225,0.18)",
        "rgba(47,125,225,0.45)",
        "rgba(47,125,225,0.75)",
        "rgba(47,125,225,1)"
      ]
    },
    "showValues": {
      "type": "boolean",
      "description": "Write the count in each cell. Best with larger components or a coarser hourStep.",
      "default": false
    },
    "showTotals": {
      "type": "boolean",
      "description": "Show bars with the total per hour (above) and per day (right).",
      "default": true
    },
    "showLegend": {
      "type": "boolean",
      "description": "Show the colour scale below the chart.",
      "default": true
    },
    "max": {
      "type": "number",
      "description": "Count that gets the last colour of the ramp. 0 = automatic (the largest cell). Set a fixed value to keep colours comparable between periods.",
      "default": 0
    },
    "valueLabel": {
      "type": "string",
      "description": "What is being counted, written after values in tooltips and the legend (e.g. alarms, stops, rejects).",
      "default": "alarms"
    },
    "title": {
      "type": "string",
      "description": "Chart title. Leave blank for no title.",
      "default": ""
    },
    "theme": {
      "type": "string",
      "description": "Name of a registered ECharts theme. Built-in themes: IgnitionIndustrialDark, IgnitionIndustrialLight. Leave empty for the ECharts default theme.",
      "default": ""
    },
    "renderer": {
      "type": "string",
      "enum": [
        "canvas",
        "svg"
      ],
      "description": "Rendering engine: canvas (better perf) or svg (better quality/export).",
      "default": "canvas"
    },
    "autoResize": {
      "type": "boolean",
      "description": "Automatically resize chart when container dimensions change.",
      "default": true
    },
    "resizeDebounceMs": {
      "type": "integer",
      "description": "Debounce interval in milliseconds for resize events.",
      "default": 150
    },
    "notMerge": {
      "type": "boolean",
      "description": "If true, setOption will not merge with previous option but replace entirely.",
      "default": false
    },
    "lazyUpdate": {
      "type": "boolean",
      "description": "If true, chart update is deferred for better performance during rapid changes.",
      "default": true
    },
    "showLoading": {
      "type": "boolean",
      "description": "Show the built-in ECharts loading animation.",
      "default": false
    },
    "loadingOptions": {
      "type": "object",
      "description": "Options for the loading animation (text, color, etc.).",
      "default": {}
    },
    "sanitizeTooltip": {
      "type": "boolean",
      "description": "Sanitises HTML in tooltip formatters and blocks non-http(s) links.",
      "default": true
    },
    "ariaLabel": {
      "type": "string",
      "description": "Accessible label announced by screen readers.",
      "default": ""
    },
    "maps": {
      "type": "object",
      "description": "Map definitions for map and geo series, keyed by map name. Each value is a GeoJSON FeatureCollection, or an object with an `svg` string. Set series.map (or geo.map) to the key.",
      "default": {}
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    }
  }
}
