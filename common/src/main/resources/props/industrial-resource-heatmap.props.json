{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resources": {
      "type": "array",
      "description": "Resource names (Y axis rows).",
      "items": { "type": "string" },
      "default": ["Line 1", "Line 2", "Line 3", "Line 4"]
    },
    "timeSlots": {
      "type": "array",
      "description": "Time-slot labels (X axis columns).",
      "items": { "type": "string" },
      "default": ["06:00", "07:00", "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00"]
    },
    "utilization": {
      "type": "array",
      "description": "Utilization matrix as rows of numbers (resources x timeSlots). Empty generates demo values. Bind to your data.",
      "items": { "type": "array", "items": { "type": "number" } },
      "default": []
    },
    "maxValue": {
      "type": "number",
      "description": "Maximum value for the colour scale (e.g. 100 for percent).",
      "default": 100
    },
    "title": {
      "type": "string",
      "description": "Chart title. Leave blank for the default title.",
      "default": ""
    },
    "option": {
      "type": "object",
      "description": "Advanced override. If non-empty, this ECharts option is used verbatim and the domain props above are ignored.",
      "default": {}
    },
    "theme": { "type": "string", "default": "" },
    "renderer": { "type": "string", "enum": ["canvas", "svg"], "default": "canvas" },
    "autoResize": { "type": "boolean", "default": true },
    "resizeDebounceMs": { "type": "integer", "default": 150 },
    "notMerge": { "type": "boolean", "default": false },
    "lazyUpdate": { "type": "boolean", "default": true },
    "showLoading": { "type": "boolean", "default": false },
    "loadingOptions": { "type": "object", "default": {} },
    "sanitizeTooltip": { "type": "boolean", "default": true },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": { "classes": "" }
    }
  }
}
