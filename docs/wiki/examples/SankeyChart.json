{"id":"vertical-gradient","label":"Vertical Sankey","description":"Top-to-bottom flow with links shaded from the source colour to the target colour; energy from source to consumer in MWh.","howTo":["Bind `series[0].data` to the node list `[{name}]` and `series[0].links` to rows `{source, target, value}` (node names). A node’s size is the sum of its links.","`orient: \"vertical\"` turns the flow top to bottom; `lineStyle.color: \"gradient\"` blends the link between its two node colours.","Every name used in `links` must exist in `data`, and the links must not form a loop."],"props":{"option":{"tooltip":{"trigger":"item","triggerOn":"mousemove"},"series":[{"type":"sankey","orient":"vertical","top":30,"bottom":30,"left":20,"right":20,"nodeWidth":16,"nodeGap":14,"label":{"position":"top","fontSize":11},"emphasis":{"focus":"adjacency"},"lineStyle":{"color":"gradient","curveness":0.5,"opacity":0.45},"data":[{"name":"Grid"},{"name":"Solar"},{"name":"Natural Gas"},{"name":"Electricity"},{"name":"Steam"},{"name":"Processing"},{"name":"Packaging"},{"name":"Utilities"},{"name":"Losses"}],"links":[{"source":"Grid","target":"Electricity","value":620},{"source":"Solar","target":"Electricity","value":180},{"source":"Natural Gas","target":"Steam","value":540},{"source":"Natural Gas","target":"Electricity","value":120},{"source":"Electricity","target":"Processing","value":380},{"source":"Electricity","target":"Packaging","value":290},{"source":"Electricity","target":"Utilities","value":190},{"source":"Electricity","target":"Losses","value":60},{"source":"Steam","target":"Processing","value":360},{"source":"Steam","target":"Utilities","value":90},{"source":"Steam","target":"Losses","value":90}]}]}}},
{"id":"levels","label":"Sankey with Level Colours","description":"Left-aligned material flow where each column has its own colour and the links take the colour of their source.","howTo":["Bind `series[0].data` to `[{name}]` and `series[0].links` to `{source, target, value}`.","`series[0].levels` styles one column each (`depth` 0 is the first column): node colour under `itemStyle.color`, link style under `lineStyle`.","`nodeAlign: \"left\"` keeps end nodes in the column right after their source instead of pushing them to the right edge.","Give a waste or loss node its own `itemStyle.color` in `data` to make it stand out, as done here."],"props":{"option":{"tooltip":{"trigger":"item","triggerOn":"mousemove"},"series":[{"type":"sankey","top":20,"bottom":20,"left":10,"right":90,"nodeAlign":"left","nodeGap":12,"emphasis":{"focus":"adjacency"},"label":{"fontSize":11},"lineStyle":{"color":"source","curveness":0.5,"opacity":0.35},"levels":[{"depth":0,"itemStyle":{"color":"#1f6fb5"}},{"depth":1,"itemStyle":{"color":"#3b9ab2"}},{"depth":2,"itemStyle":{"color":"#78b7c5"}},{"depth":3,"itemStyle":{"color":"#ebcc2a"}},{"depth":4,"itemStyle":{"color":"#e69138"}}],"data":[{"name":"Raw Milk"},{"name":"Separation"},{"name":"Skim"},{"name":"Cream"},{"name":"Pasteurising"},{"name":"Waste","itemStyle":{"color":"#d9534f"}},{"name":"Butter Plant"},{"name":"Filling"},{"name":"Good Product"},{"name":"Rework"}],"links":[{"source":"Raw Milk","target":"Separation","value":1000},{"source":"Separation","target":"Skim","value":620},{"source":"Separation","target":"Cream","value":380},{"source":"Skim","target":"Pasteurising","value":600},{"source":"Skim","target":"Waste","value":20},{"source":"Cream","target":"Butter Plant","value":250},{"source":"Cream","target":"Pasteurising","value":130},{"source":"Pasteurising","target":"Filling","value":700},{"source":"Pasteurising","target":"Waste","value":30},{"source":"Filling","target":"Good Product","value":660},{"source":"Filling","target":"Rework","value":25},{"source":"Filling","target":"Waste","value":15},{"source":"Butter Plant","target":"Good Product","value":240},{"source":"Butter Plant","target":"Waste","value":10}]}]}}}
