{"id":"drill-down","label":"Drill-down Treemap","description":"Shows one level at a time; click a block to drill in and use the breadcrumb to go back. Energy use in MWh.","howTo":["Bind `series[0].data` to a tree: `[{name, children: [{name, children: [{name, value}]}]}]`. Parents are sized by the sum of their children.","`leafDepth: 1` shows one level at a time; a click drills into a block and the breadcrumb at the bottom goes back. Remove it to show all levels at once.","`series[0].name` is the text of the first breadcrumb. Change the unit in `label.formatter` and `tooltip.formatter`."],"props":{"option":{"tooltip":{"formatter":"{b}: {c} MWh"},"series":[{"type":"treemap","name":"Plant","leafDepth":1,"roam":false,"top":10,"left":10,"right":10,"bottom":44,"breadcrumb":{"bottom":8},"label":{"formatter":"{b}\n{c} MWh","fontSize":14},"itemStyle":{"gapWidth":3,"borderRadius":4},"levels":[{"itemStyle":{"gapWidth":4}},{"colorSaturation":[0.3,0.6],"itemStyle":{"gapWidth":3,"borderColorSaturation":0.7}},{"colorSaturation":[0.3,0.5],"itemStyle":{"gapWidth":2}}],"data":[{"name":"Processing","children":[{"name":"Mixing","children":[{"name":"Mixer 1","value":12},{"name":"Mixer 2","value":10},{"name":"CIP Skid","value":6}]},{"name":"Thermal","children":[{"name":"Pasteuriser","value":18},{"name":"Homogeniser","value":14}]}]},{"name":"Packaging","children":[{"name":"Line 1","children":[{"name":"Filler","value":9},{"name":"Capper","value":4},{"name":"Labeller","value":5}]},{"name":"Line 2","children":[{"name":"Filler","value":10},{"name":"Packer","value":7},{"name":"Palletiser","value":6}]}]},{"name":"Utilities","children":[{"name":"Air","children":[{"name":"Comp A","value":11},{"name":"Comp B","value":9}]},{"name":"Steam","children":[{"name":"Boiler","value":16}]},{"name":"Chillers","value":13}]}]}]}}},
{"id":"parent-labels","label":"Treemap with Parent Labels","description":"All levels at once: each group has a header strip and its children nested inside, disk-usage style.","howTo":["Bind `series[0].data` to your tree (`{name, value}` leaves, `{name, children}` branches).","The header strips are `upperLabel`; their height is `upperLabel.height`. `levels[n]` styles one depth each (index 0 is the whole chart): border and gap widths separate the groups.","Blocks smaller than `visibleMin` square pixels are hidden."],"props":{"option":{"tooltip":{"formatter":"{b}: {c} MWh"},"series":[{"type":"treemap","name":"Plant","roam":false,"nodeClick":false,"top":10,"left":10,"right":10,"bottom":10,"breadcrumb":{"show":false},"visibleMin":300,"label":{"show":true,"formatter":"{b}","fontSize":11},"upperLabel":{"show":true,"height":22,"color":"#fff"},"itemStyle":{"borderColor":"#fff"},"levels":[{"itemStyle":{"borderWidth":0,"gapWidth":4},"upperLabel":{"show":false}},{"itemStyle":{"borderWidth":4,"gapWidth":2,"borderColorSaturation":0.55}},{"itemStyle":{"borderWidth":3,"gapWidth":1,"borderColorSaturation":0.4},"colorSaturation":[0.35,0.5]},{"colorSaturation":[0.4,0.7]}],"data":[{"name":"Processing","children":[{"name":"Mixing","children":[{"name":"Mixer 1","value":12},{"name":"Mixer 2","value":10},{"name":"CIP Skid","value":6}]},{"name":"Thermal","children":[{"name":"Pasteuriser","value":18},{"name":"Homogeniser","value":14}]}]},{"name":"Packaging","children":[{"name":"Line 1","children":[{"name":"Filler","value":9},{"name":"Capper","value":4},{"name":"Labeller","value":5}]},{"name":"Line 2","children":[{"name":"Filler","value":10},{"name":"Packer","value":7},{"name":"Palletiser","value":6}]}]},{"name":"Utilities","children":[{"name":"Air","children":[{"name":"Comp A","value":11},{"name":"Comp B","value":9}]},{"name":"Steam","children":[{"name":"Boiler","value":16}]},{"name":"Chillers","value":13}]}]}]}}},
{"id":"heat","label":"Heat Treemap","description":"Area shows output and colour shows a second measure (OEE %) on a red-to-green gradient.","howTo":["Bind `series[0].data` to rows of `{name, value: [size, measure]}`: the first number sets the area, the second the colour.","Set `visualMap.min` / `max` to the range of the colour measure and edit the ramp in `visualMap.inRange.color`.","The label shows the second number through `{@[1]}` in `label.formatter`."],"props":{"option":{"tooltip":{"formatter":"{b}"},"visualMap":{"type":"continuous","dimension":1,"min":50,"max":100,"orient":"horizontal","left":"center","bottom":4,"itemWidth":12,"itemHeight":200,"text":["100 % OEE","50 %"],"inRange":{"color":["#d9534f","#f0ad4e","#5cb85c"]}},"series":[{"type":"treemap","roam":false,"nodeClick":false,"top":10,"left":10,"right":10,"bottom":50,"breadcrumb":{"show":false},"itemStyle":{"gapWidth":3,"borderRadius":3},"label":{"formatter":"{b}\n{@[1]} %","color":"#fff","fontSize":13},"data":[{"name":"Mixer 1","value":[30,88]},{"name":"Mixer 2","value":[26,79]},{"name":"Pasteuriser","value":[44,93]},{"name":"Homogeniser","value":[36,84]},{"name":"Filler 1","value":[40,71]},{"name":"Capper 1","value":[18,90]},{"name":"Labeller","value":[22,64]},{"name":"Filler 2","value":[42,86]},{"name":"Case Packer","value":[28,58]},{"name":"Palletiser","value":[24,95]},{"name":"Wrapper","value":[14,76]}]}]}}}
