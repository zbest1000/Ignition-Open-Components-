  {"id":"donut-rounded","label":"Rounded Donut","description":"A donut with gaps between the slices and rounded corners. The hovered slice is named in the centre.","props":{"option":{"tooltip":{"trigger":"item"},"legend":{"top":"5%","left":"center"},"series":[{"name":"Downtime","type":"pie","radius":["40%","70%"],"center":["50%","56%"],"avoidLabelOverlap":false,"padAngle":5,"itemStyle":{"borderRadius":10},"label":{"show":false,"position":"center"},"emphasis":{"label":{"show":true,"fontSize":28,"fontWeight":"bold"}},"labelLine":{"show":false},"data":[{"value":1048,"name":"Breakdown"},{"value":735,"name":"Changeover"},{"value":580,"name":"Material"},{"value":484,"name":"Cleaning"},{"value":300,"name":"Other"}]}]}},"howTo":["Bind `series[0].data` to a list of `{name, value}` objects, for example from a named query with a script transform.","`padAngle` is the gap between slices in degrees and `itemStyle.borderRadius` the corner rounding.","Labels are hidden until a slice is hovered; its name then appears in the middle (`emphasis.label`)."]},
  {"id":"customized-dark","label":"Customized Pie (Dark)","description":"A rose pie in shades of one colour, lighter for larger values, on its own dark panel. The dark background and text colours are part of the look and do not follow the theme.","props":{"option":{"backgroundColor":"#2c343c","title":{"text":"Scrap by Cause","left":"center","top":20,"textStyle":{"color":"#ccc"}},"tooltip":{"trigger":"item"},"visualMap":{"show":false,"min":80,"max":600,"inRange":{"colorLightness":[0,1]}},"series":[{"name":"Scrap","type":"pie","radius":"55%","center":["50%","55%"],"roseType":"radius","data":[{"value":200,"name":"Underfill"},{"value":274,"name":"Label"},{"value":310,"name":"Seal"},{"value":335,"name":"Dents"},{"value":400,"name":"Cap"}],"label":{"color":"rgba(255, 255, 255, 0.6)"},"labelLine":{"lineStyle":{"color":"rgba(255, 255, 255, 0.4)"},"smooth":0.2,"length":10,"length2":20},"itemStyle":{"color":"#c23531","shadowBlur":200,"shadowColor":"rgba(0, 0, 0, 0.5)"},"animationType":"scale","animationEasing":"elasticOut"}]}},"howTo":["Bind `series[0].data` to `{name, value}` objects. Supply them sorted by value: the chart draws them in the order given.","Set `visualMap.min` and `visualMap.max` to just below and above your data range: they map the value to how light the slice is drawn.","The background and text colours are fixed (`backgroundColor`, `title.textStyle.color`, `label.color`) and do not follow the theme."]},
  {"id":"nightingale","label":"Nightingale Rose","description":"Slices of equal angle whose radius shows the value, with rounded corners.","props":{"option":{"tooltip":{"trigger":"item"},"legend":{"top":"bottom"},"series":[{"name":"Energy","type":"pie","radius":["8%","62%"],"center":["50%","46%"],"roseType":"area","itemStyle":{"borderRadius":8},"data":[{"value":40,"name":"Compressors"},{"value":38,"name":"HVAC"},{"value":32,"name":"Line 1"},{"value":30,"name":"Line 2"},{"value":28,"name":"Chillers"},{"value":26,"name":"Boilers"},{"value":22,"name":"Lighting"},{"value":18,"name":"Pumps"}]}]}},"howTo":["Bind `series[0].data` to `{name, value}` objects. `roseType: \"area\"` gives every slice the same angle and shows the value as radius; `\"radius\"` varies both."]},
  {"id":"half-donut","label":"Half Donut","description":"A donut drawn over a half circle, for a share-of-total readout that takes less height.","props":{"option":{"tooltip":{"trigger":"item"},"legend":{"top":"5%","left":"center"},"series":[{"name":"Shift output","type":"pie","radius":["40%","70%"],"center":["50%","72%"],"startAngle":180,"endAngle":360,"label":{"formatter":"{d}%"},"data":[{"value":1048,"name":"Day"},{"value":735,"name":"Late"},{"value":580,"name":"Night"},{"value":300,"name":"Weekend"}]}]}},"howTo":["Bind `series[0].data` to `{name, value}` objects. `startAngle: 180` and `endAngle: 360` draw the upper half only; `center` moves it down to use the space."]},
